{"session": "root-multipv", "description": "following the root of a search for two lines says which line each engine/root is about (spec 7.9)", "requires": ["engine", "engine.root", "engine.multipv", "limits.maxMultipv"]}
{"send": {"jsonrpc": "2.0", "id": 1, "method": "initialize", "params": {"protocol": "1.0", "client": {"name": "cnp-conformance", "version": "1.0"}}}}
{"expect": {"id": 1, "result": {"protocol": "1.0", "node": {"name": "$string", "version": "$string", "license": "$string"}, "capabilities": "$object"}}}
{"send": {"jsonrpc": "2.0", "id": 2, "method": "engine/search", "params": {"position": {"fen": "rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1"}, "limits": {"depth": 5}, "multipv": 2, "rootMs": 0}}}
{"expect": {"method": "engine/root", "params": {"id": 2, "multipv": "$integer", "move": "$move"}}}
{"expect": {"id": 2, "result": {"bestMove": "$move", "lines": [{"multipv": 1}, {"multipv": 2}]}}}
{"send": {"jsonrpc": "2.0", "id": 99, "method": "shutdown"}}
{"expect": {"id": 99, "result": null}}
{"send": {"jsonrpc": "2.0", "method": "exit"}}
{"expectExit": 0}
