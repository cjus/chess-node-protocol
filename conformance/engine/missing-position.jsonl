{"session": "missing-position", "description": "a search without a position is InvalidParams (spec 9)", "requires": ["engine"]}
{"send": {"jsonrpc": "2.0", "id": 1, "method": "initialize", "params": {"protocol": "1.0", "client": {"name": "cnp-conformance", "version": "1.0"}}}}
