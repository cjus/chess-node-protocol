{"session": "ping-while-searching", "description": "ping is answered while a search runs (spec 5.2)", "requires": ["engine"]}
{"send": {"jsonrpc": "2.0", "id": 1, "method": "initialize", "params": {"protocol": "1.0", "client": {"name": "cnp-conformance", "version": "1.0"}}}}
{"expect": {"id": 1, "result": {"protocol": "1.0", "node": {"name": "$string", "version": "$string", "license": "$string"}, "capabilities": "$object"}}}
{"send": {"jsonrpc": "2.0", "id": 2, "method": "engine/search", "params": {"position": {"fen": "rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1"}, "limits": {"infinite": true}}}}
{"send": {"jsonrpc": "2.0", "id": 3, "method": "ping"}}
{"expect": {"id": 3, "result": null}}
{"send": {"jsonrpc": "2.0", "method": "$/cancelRequest", "params": {"id": 2}}}
{"expect": {"id": 2, "error": {"code": -32800, "message": "$string"}}}
{"send": {"jsonrpc": "2.0", "id": 99, "method": "shutdown"}}
{"expect": {"id": 99, "result": null}}
{"send": {"jsonrpc": "2.0", "method": "exit"}}
{"expectExit": 0}
