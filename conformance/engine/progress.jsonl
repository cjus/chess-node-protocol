{"session": "progress", "description": "a search that asks for progress gets engine/progress before its result (spec 7.2)", "requires": ["engine", "engine.progress"]}
{"send": {"jsonrpc": "2.0", "id": 1, "method": "initialize", "params": {"protocol": "1.0", "client": {"name": "cnp-conformance", "version": "1.0"}}}}
{"expect": {"id": 1, "result": {"protocol": "1.0", "node": {"name": "$string", "version": "$string", "license": "$string"}, "capabilities": "$object"}}}
{"send": {"jsonrpc": "2.0", "id": 2, "method": "engine/search", "params": {"position": {"fen": "rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1"}, "limits": {"depth": 5}, "progressMs": 0}}}
{"expect": {"method": "engine/progress", "params": {"id": 2, "depth": "$integer", "score": "$object", "pv": "$array", "nodes": "$integer", "timeMs": "$integer"}}}
{"expect": {"id": 2, "result": {"bestMove": "$move"}}}
{"send": {"jsonrpc": "2.0", "id": 99, "method": "shutdown"}}
{"expect": {"id": 99, "result": null}}
{"send": {"jsonrpc": "2.0", "method": "exit"}}
{"expectExit": 0}
