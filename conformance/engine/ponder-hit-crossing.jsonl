{"session": "ponder-hit-crossing", "description": "a hit for a search that never existed is not an error, and one for a search that isn't pondering is InvalidParams (spec 7.7)", "requires": ["engine", "engine.ponder"]}
{"send": {"jsonrpc": "2.0", "id": 1, "method": "initialize", "params": {"protocol": "1.0", "client": {"name": "cnp-conformance", "version": "1.0"}}}}
{"expect": {"id": 1, "result": {"protocol": "1.0", "node": {"name": "$string", "version": "$string", "license": "$string"}, "capabilities": "$object"}}}
{"send": {"jsonrpc": "2.0", "id": 2, "method": "engine/ponderHit", "params": {"id": 12345}}}
{"expect": {"id": 2, "result": null}}
{"send": {"jsonrpc": "2.0", "id": 3, "method": "engine/search", "params": {"position": {"fen": "rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1", "moves": ["e2e4", "e7e5"]}, "limits": {"infinite": true}}}}
{"send": {"jsonrpc": "2.0", "id": 4, "method": "engine/ponderHit", "params": {"id": 3}}}
{"expect": {"id": 4, "error": {"code": -32602, "message": "$string"}}}
{"send": {"jsonrpc": "2.0", "id": 5, "method": "engine/stop", "params": {"id": 3}}}
{"expectAll": [{"id": 5, "result": null}, {"id": 3, "result": {"bestMove": "$move", "stopped": true}}]}
{"send": {"jsonrpc": "2.0", "id": 99, "method": "shutdown"}}
{"expect": {"id": 99, "result": null}}
{"send": {"jsonrpc": "2.0", "method": "exit"}}
{"expectExit": 0}
