{"session": "ponder-hit", "description": "a ponder search doesn't answer before its hit, even past its limits, and after engine/ponderHit answers with ponderMs (spec 7.7)", "requires": ["engine", "engine.ponder"]}
{"send": {"jsonrpc": "2.0", "id": 1, "method": "initialize", "params": {"protocol": "1.0", "client": {"name": "cnp-conformance", "version": "1.0"}}}}
{"expect": {"id": 1, "result": {"protocol": "1.0", "node": {"name": "$string", "version": "$string", "license": "$string"}, "capabilities": "$object"}}}
{"send": {"jsonrpc": "2.0", "id": 2, "method": "engine/search", "params": {"position": {"fen": "rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1", "moves": ["e2e4", "e7e5"]}, "limits": {"depth": 1}, "ponder": true}}}
{"comment": "Depth 1 takes no time, but a ponder search keeps to no limit until the hit: the ping is answered and the search isn't."}
{"send": {"jsonrpc": "2.0", "id": 3, "method": "ping"}}
{"expect": {"id": 3, "result": null}}
{"send": {"jsonrpc": "2.0", "id": 4, "method": "engine/ponderHit", "params": {"id": 2}}}
{"comment": "Depth 1 is long passed, so the hit ends the search at once."}
{"expectAll": [{"id": 4, "result": null}, {"id": 2, "result": {"bestMove": "$move", "ponderMs": "$integer"}}]}
{"send": {"jsonrpc": "2.0", "id": 99, "method": "shutdown"}}
{"expect": {"id": 99, "result": null}}
{"send": {"jsonrpc": "2.0", "method": "exit"}}
{"expectExit": 0}
