{"session": "evaluate", "description": "engine/evaluate scores a position and lists its terms, and refuses an illegal move (spec 7.6)", "requires": ["engine", "engine.evaluate"]}
{"send": {"jsonrpc": "2.0", "id": 1, "method": "initialize", "params": {"protocol": "1.0", "client": {"name": "cnp-conformance", "version": "1.0"}}}}
{"expect": {"id": 1, "result": {"protocol": "1.0", "node": {"name": "$string", "version": "$string", "license": "$string"}, "capabilities": "$object"}}}
{"send": {"jsonrpc": "2.0", "id": 2, "method": "engine/evaluate", "params": {"position": {"fen": "rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1", "moves": ["e2e4"]}}}}
{"expect": {"id": 2, "result": {"score": {"cp": "$integer"}, "terms": "$array"}}}
{"send": {"jsonrpc": "2.0", "id": 3, "method": "engine/evaluate", "params": {"position": {"fen": "rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1", "moves": ["e2e5"]}}}}
{"expect": {"id": 3, "error": {"code": -32011, "message": "$string"}}}
