{"session": "hotwords-bad-params", "description": "a hotword that is empty or holds a line break is InvalidParams, in a transcription and in a listen, whether or not the models are ready (spec 8)", "requires": ["voice", "voice.hotwords", "voice.transcribe", "voice.listen"]}
{"send": {"jsonrpc": "2.0", "id": 1, "method": "initialize", "params": {"protocol": "1.0", "client": {"name": "cnp-conformance", "version": "1.0"}}}}
