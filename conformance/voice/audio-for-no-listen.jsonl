{"session": "audio-for-no-listen", "description": "audio for a listen the node doesn't have is ignored, not answered: the two can cross (spec 8.5)", "requires": ["voice", "voice.listen"]}
{"send": {"jsonrpc": "2.0", "id": 1, "method": "initialize", "params": {"protocol": "1.0", "client": {"name": "cnp-conformance", "version": "1.0"}}}}
{"expect": {"id": 1, "result": {"protocol": "1.0", "node": {"name": "$string", "version": "$string", "license": "$string"}, "capabilities": "$object"}}}
{"send": {"jsonrpc": "2.0", "method": "voice/audio", "params": {"id": 77, "audio": "AAAAAAAAAAA="}}}
{"send": {"jsonrpc": "2.0", "method": "voice/audio", "params": {"id": 77, "end": true}}}
{"comment": "Nothing answers the audio: the ping's answer comes next."}
{"send": {"jsonrpc": "2.0", "id": 2, "method": "ping"}}
{"expect": {"id": 2, "result": null}}
{"send": {"jsonrpc": "2.0", "id": 99, "method": "shutdown"}}
{"expect": {"id": 99, "result": null}}
{"send": {"jsonrpc": "2.0", "method": "exit"}}
{"expectExit": 0}
